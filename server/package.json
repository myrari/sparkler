{
	"name": "sparkler",
	"version": "0.1.0",
	"description": "Web server for handling requests from the Sparkler Minecraft mod",
	"license": "MIT",
	"author": "@myrari",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"build": "npx tsc -p tsconfig.json && cp -ar src/dist/* dist/",
		"start": "node --env-file=.env dist/index.js",
		"dev": "npx tsx --env-file=.env --watch  src/index.ts"
	},
	"dependencies": {
		"express": "^5.1.0",
		"socket.io-client": "^4.8.3",
		"typescript": "^6.0.2"
	},
	"devDependencies": {
		"@tsconfig/node24": "^24.0.3",
		"@types/express": "^5.0.3",
		"@types/node": "^24.6.2",
		"@types/socket.io-client": "^1.4.36"
	}
}
